{
  "name": "@lummi/miniapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "size": "node scripts/check-bundle-size.mjs",
    "shots": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx shots/run.ts",
    "e2e": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../node_modules/@playwright/test/cli.js test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lummi/contracts": "*",
    "@lummi/i18n": "*",
    "@lummi/rich-text": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@ts-rest/core": "~3.52.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lummi/config": "*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
