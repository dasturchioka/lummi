{
  "name": "@lummi/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "dev:worker": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/worker.ts",
    "bts:fetch": "node --import tsx src/cli/bts-fetch.ts",
    "bts:import": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/cli/bts-import.ts",
    "seed:catalog": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/cli/seed-catalog.ts",
    "seed:owner": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/cli/seed-owner.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@lummi/contracts": "*",
    "@lummi/db": "*",
    "@lummi/i18n": "*",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@ts-rest/core": "~3.52.1",
    "@ts-rest/nest": "~3.52.1",
    "bullmq": "^6.7.2",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@lummi/config": "*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "vitest": "^5.1.0"
  }
}
