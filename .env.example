# Copy to .env.local (git-ignored) and edit. Real secrets never go in this file.
# Every host port is configurable so several stacks can run side by side.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000

# Postgres (docker-compose.dev.yml publishes it on POSTGRES_HOST_PORT)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://lummi:lummi@127.0.0.1:5432/lummi

# Redis (docker-compose.dev.yml publishes it on REDIS_HOST_PORT); used by the worker only
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Bot mode: polling (local dev; only ONE process may poll a token) | webhook (staging, production) | off
BOT_MODE=off
# Webhook mode: public https URL of POST /telegram/webhook, and the secret Telegram echoes in a header
# WEBHOOK_URL=https://staging.example.com/telegram/webhook
# WEBHOOK_SECRET=            # 1-256 chars of A-Z a-z 0-9 _ -
# Mini App https URL behind the /start web_app button and the menu button.
# Locally: Sardor's named Cloudflare Tunnel hostname (ADR 0023).
# MINIAPP_URL=https://lummi-dev.<your-tunnel-domain>/

# Dev bot token: the signing key of initData (never the production token)
BOT_TOKEN=
# Signs our session tokens; at least 32 characters
SESSION_SECRET=change-me-change-me-change-me-change-me
# (production refuses any value starting with "change-me")

# Admin panel (apps/admin). Sign-in = Telegram Login Widget (ADR 0017): the widget only works on a
# domain set with BotFather /setdomain for the bot below (dev: the Cloudflare tunnel host, ADR 0023).
ADMIN_PORT=6000
# Where the admin proxies /api/* (dev: next dev rewrites; read at build time by `next build`)
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BOT_USERNAME=
# Dev/test only: sign in as a staff member by Telegram id, no widget. The API refuses to boot with
# ADMIN_DEV_LOGIN=true when NODE_ENV=production; the admin form needs the NEXT_ twin to show it.
ADMIN_DEV_LOGIN=false
NEXT_PUBLIC_ADMIN_DEV_LOGIN=false

# Internal endpoints the userbot calls (ADR 0015, ADR 0031). Without a secret they answer 404.
# INTERNAL_API_SECRET=          # at least 32 characters; the userbot is given the same value
# Source networks allowed to call them, comma-separated CIDRs (default: loopback only).
# A Compose deploy with the userbot in its own container adds that network's subnet.
# INTERNAL_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# Receipt AI (ADR 0013): TypeSafe answers first, OpenAI Decisions is the fallback.
# TYPESAFE_API_KEY is required in production. OPENAI_API_KEY is optional everywhere: without it the
# fallback fails as not-configured and a receipt TypeSafe cannot confirm waits for a person.
# TYPESAFE_API_KEY=
# OPENAI_API_KEY=

# Private file storage (receipts later)
FILES_DIR=./media

# Integration tests: set to reuse a running Postgres instead of starting a Testcontainers one
# TEST_DATABASE_URL=postgres://lummi:lummi@127.0.0.1:5432/postgres

# The bot's https link, the base of broadcast buttons (<link>?startapp=<target>). Required in production
# (the customer's bot); locally the dev bot's. Unset in dev/test falls back to https://t.me/lummi_dev_bot.
# BOT_LINK=https://t.me/<your_dev_bot>
# BullMQ queue of broadcast deliveries. API and worker must agree; the default is fine unless you run two stacks on one Redis.
# BROADCAST_QUEUE=broadcasts
