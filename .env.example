# Copy to .env.local (git-ignored) and edit. Real secrets never go in this file.
# Every host port is configurable so several stacks can run side by side.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000

# Postgres (docker-compose.dev.yml publishes it on POSTGRES_HOST_PORT)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://lummi:lummi@127.0.0.1:5432/lummi

# Dev bot token: the signing key of initData (never the production token)
BOT_TOKEN=
# Signs our session tokens; at least 32 characters
SESSION_SECRET=change-me-change-me-change-me-change-me
# (production refuses any value starting with "change-me")

# Admin panel (apps/admin). Sign-in = Telegram Login Widget (ADR 0017): the widget only works on a
# domain set with BotFather /setdomain for the bot below (dev: the Cloudflare tunnel host, ADR 0023).
ADMIN_PORT=6000
# Where the admin proxies /api/* (dev: next dev rewrites; read at build time by `next build`)
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BOT_USERNAME=
# Dev/test only: sign in as a staff member by Telegram id, no widget. The API refuses to boot with
# ADMIN_DEV_LOGIN=true when NODE_ENV=production; the admin form needs the NEXT_ twin to show it.
ADMIN_DEV_LOGIN=false
NEXT_PUBLIC_ADMIN_DEV_LOGIN=false

# Private file storage (receipts later)
FILES_DIR=./media

# Integration tests: set to reuse a running Postgres instead of starting a Testcontainers one
# TEST_DATABASE_URL=postgres://lummi:lummi@127.0.0.1:5432/postgres
