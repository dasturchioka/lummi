{
  "name": "lummi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "turbo run lint typecheck test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "dev:api": "npm run dev -w @lummi/api",
    "dev:admin": "npm run dev -w @lummi/admin",
    "seed:catalog": "npm run seed:catalog -w @lummi/api",
    "seed:owner": "npm run seed:owner -w @lummi/api --",
    "set-owner-password": "npm run set-owner-password -w @lummi/api --",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "npm run generate -w @lummi/db",
    "db:migrate": "npm run migrate -w @lummi/db",
    "dev:worker": "npm run dev:worker -w @lummi/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@mtcute/core": "0.32.7",
    "@mtcute/file-id": "0.32.6",
    "@mtcute/html-parser": "0.32.7",
    "@mtcute/markdown-parser": "0.32.7",
    "@mtcute/tl-runtime": "0.32.6",
    "@mtcute/wasm": "0.32.6"
  }
}
