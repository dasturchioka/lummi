# /opt/lummi-staging/.env on the VPS (chmod 600, owner lummi-deploy). Never committed with values.
# docs/run-guide.md explains every key. Production uses the same keys on the customer's server.

COMPOSE_PROJECT_NAME=lummi-staging
DOMAIN=lummi.dasturchioka.uz
# staging: plain HTTP behind the host nginx. Production: leave empty (Caddy gets certificates itself).
CADDY_SCHEME=http://
# staging: loopback only, nginx proxies here. Production: delete both lines (80:80 and 443:443).
CADDY_HTTP_PUBLISH=127.0.0.1:4180:80
CADDY_HTTPS_PUBLISH=127.0.0.1:4143:443
# The one hop allowed to set X-Forwarded-*: the Compose gateway (docker network inspect lummi-staging_lummi). Production: leave unset.
TRUSTED_PROXIES=172.28.0.1/32

POSTGRES_PASSWORD=
BOT_TOKEN=
SESSION_SECRET=
WEBHOOK_SECRET=
INTERNAL_API_SECRET=
BOT_LINK=https://t.me/lummi_staging_bot
ADMIN_BOT_USERNAME=lummi_staging_bot
TYPESAFE_API_KEY=
OPENAI_API_KEY=
# BOT_MODE=webhook
# LOG_LEVEL=info
# The owner's oil price list (#75): customer data, never committed. A path inside the api container,
# e.g. in the files volume's private/ (never served). Empty = the seed skips oil prices.
# OIL_PRICES_FILE=/data/files/private/oil-prices.json

# Backups (deploy/backup, docs/run-guide.md "Backups and restore"). Read by the host's backup.sh, not by the containers.
# BACKUP_AGE_RECIPIENT=age1...          the owner's PUBLIC key; the private key stays offline with the owner
# BACKUP_RSYNC_TARGET=backup@host:/srv/lummi   second location inside Uzbekistan (pending from the customer); empty = skipped
# BACKUP_SSH_KEY=/root/.ssh/lummi_backup                 add-only key (dumps, secrets, public photos)
# BACKUP_RSYNC_TARGET_PRIVATE=  BACKUP_SSH_KEY_PRIVATE=  the encrypted receipt mirror (defaults: <target>/private, the same key)
# BACKUP_MAX_PURGE=50
# BACKUP_ALERT_CHAT_ID=                 Telegram chat told when a backup fails (failure-alert.sh)
# BACKUP_FILES_DIR=/var/lib/docker/volumes/<COMPOSE_PROJECT_NAME>_files/_data
# BACKUP_USERBOT_SESSION=               the session file in the userbot-data volume (ticket #19)
# BACKUP_DIR=/var/backups/lummi   BACKUP_KEEP_DAILY=14   BACKUP_KEEP_WEEKLY=8

# Humo userbot (docs/run-guide.md → Userbot). Set COMPOSE_PROFILES only after the login.
# COMPOSE_PROFILES=userbot
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION_KEY=
USERBOT_LISTEN_CHAT_ID=
# Production only: true (the official Humo bot is verified). Leave unset on staging (test bot).
# USERBOT_REQUIRE_VERIFIED=true
