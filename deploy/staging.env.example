# /opt/lummi-staging/.env on the VPS (chmod 600, owner lummi-deploy). Never committed with values.
# docs/run-guide.md explains every key. Production uses the same keys on the customer's server.

COMPOSE_PROJECT_NAME=lummi-staging
DOMAIN=lummi.dasturchioka.uz
# staging: plain HTTP behind the host nginx. Production: leave empty (Caddy gets certificates itself).
CADDY_SCHEME=http://
# staging: loopback only, nginx proxies here. Production: delete both lines (80:80 and 443:443).
CADDY_HTTP_PUBLISH=127.0.0.1:4180:80
CADDY_HTTPS_PUBLISH=127.0.0.1:4143:443
# The one hop allowed to set X-Forwarded-*: the Compose gateway (docker network inspect lummi-staging_lummi). Production: leave unset.
TRUSTED_PROXIES=172.28.0.1/32

POSTGRES_PASSWORD=
BOT_TOKEN=
SESSION_SECRET=
WEBHOOK_SECRET=
INTERNAL_API_SECRET=
BOT_LINK=https://t.me/lummi_staging_bot
ADMIN_BOT_USERNAME=lummi_staging_bot
TYPESAFE_API_KEY=
OPENAI_API_KEY=
# BOT_MODE=webhook
# LOG_LEVEL=info

# Humo userbot (docs/run-guide.md → Userbot). Set COMPOSE_PROFILES only after the login.
# COMPOSE_PROFILES=userbot
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION_KEY=
USERBOT_LISTEN_CHAT_ID=
# Production only: true (the official Humo bot is verified). Leave unset on staging (test bot).
# USERBOT_REQUIRE_VERIFIED=true
