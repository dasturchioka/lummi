# One Caddyfile for staging and production (ADR 0024). Hosts and mode come from the environment:
#   DOMAIN        lummi.example.uz           -> <DOMAIN>, api.<DOMAIN>, admin.<DOMAIN>, media.<DOMAIN>
#   CADDY_SCHEME  ""          production: automatic HTTPS on 80/443
#                 "http://"   staging: plain HTTP behind the host's nginx, which terminates TLS
{
	# Staging: nginx on the host reaches us from a private address and sets X-Forwarded-*;
	# trust those headers from private ranges only, so a direct internet client cannot forge them.
	servers {
		trusted_proxies static private_ranges
	}
}

(hardening) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	encode zstd gzip
}

# The Mini App: static build with an SPA fallback; /api/* is the API (prefix stripped), same origin.
{$CADDY_SCHEME}{$DOMAIN} {
	import hardening

	@blocked path /api/internal/* /api/media/private* /media/private*
	handle @blocked {
		respond 404
	}
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	# Vite names these by content hash: cache forever. Missing ones stay 404 (no SPA fallback).
	handle /assets/* {
		root * /srv/miniapp
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/miniapp
		header /fonts/* Cache-Control "public, max-age=604800"
		header /brand/* Cache-Control "public, max-age=604800"
		header /home/* Cache-Control "public, max-age=604800"
		# Deep links (/orders/42, /product/...) fall back to index.html, which must never be stale.
		@spa not path /fonts/* /brand/* /home/*
		header @spa Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# The API, including the bot webhook (POST /telegram/webhook). /internal/* is never routed (ADR 0031).
{$CADDY_SCHEME}api.{$DOMAIN} {
	import hardening

	@blocked path /internal/* /media/private*
	handle @blocked {
		respond 404
	}
	handle {
		reverse_proxy api:4000
	}
}

# The admin panel; /api/* goes to the API so the session cookie is same-origin (ADR 0027).
{$CADDY_SCHEME}admin.{$DOMAIN} {
	import hardening

	@blocked path /api/internal/* /api/media/private* /media/private*
	handle @blocked {
		respond 404
	}
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy admin:3000
	}
}

# Public product photos straight from the files volume (ADR 0020). Nothing else is served here:
# only the volume's public/ subfolder is mounted into this container (read-only), so receipts
# under private/ are not even present here (ADR 0025).
{$CADDY_SCHEME}media.{$DOMAIN} {
	import hardening

	@photo path_regexp ^/media/public/[a-f0-9]{16}-(400|800|1200)\.webp$
	handle @photo {
		uri strip_prefix /media/public
		root * /srv/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		respond 404
	}
}
